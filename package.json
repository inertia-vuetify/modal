{
  "name": "@inertia-vuetify/modal",
  "version": "3.0.2",
  "description": "Vuetify modals and slideovers for Inertia.js, compatible with the inertiaui/modal Laravel package",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inertia-vuetify/modal.git"
  },
  "main": "./dist/inertia-modal-vuetify.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/inertia-modal-vuetify.js"
    },
    "./src": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "vite serve example",
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "build:example": "vite build example",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "vue": "^3.5.0",
    "vuetify": "^4.2.0",
    "@inertiajs/core": "^3.0.0",
    "@inertiajs/vue3": "^3.0.0"
  },
  "dependencies": {
    "@inertiaui/vanilla": "^1.5.0"
  },
  "devDependencies": {
    "@inertiajs/core": "^3.9.1",
    "@inertiajs/vue3": "^3.9.1",
    "@mdi/font": "^7.4.47",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^5.0.5",
    "vue": "^3.5.44",
    "vue-tsc": "^3.3.13",
    "vuetify": "^4.3.0"
  },
  "keywords": [
    "inertia",
    "inertiajs",
    "modal",
    "vuetify",
    "vue"
  ],
  "author": "",
  "license": "MIT"
}
